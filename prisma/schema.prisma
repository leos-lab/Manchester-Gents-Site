generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  MEMBER
  ADMIN
}

enum SignupStatus {
  CONFIRMED
  WAITLISTED
  CANCELLED
}

model ComingSoonConfig {
  id        Int       @id @default(1)
  enabled   Boolean   @default(true)
  disableAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model PhotoNoticeConfig {
  id        Int      @id @default(1)
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model User {
  id                      String               @id @default(cuid())
  email                   String               @unique
  passwordHash            String
  instagramHandle         String               @unique
  firstName               String?
  lastName                String?
  preferredName           String?
  name                    String?
  fullName                String?
  shareFirstName          Boolean              @default(false)
  phoneNumber             String?
  preferredContactMethod  String?
  profilePhotoUrl         String?
  profilePhotoOriginalUrl String?
  generalPhotoConsent     Boolean?             @default(false)
  groupFaceConsent        Boolean?             @default(false)
  otherFaceConsent        Boolean?             @default(false)
  taggingConsent          Boolean?             @default(false)
  isPlaceholder           Boolean              @default(false)
  termsConsentCulture     Boolean              @default(false)
  termsSafeSpace          Boolean              @default(false)
  termsNoHate             Boolean              @default(false)
  termsPrivacy            Boolean              @default(false)
  termsGuidelines         Boolean              @default(false)
  termsAgreed             Boolean              @default(false)
  termsSignedAt           DateTime?
  consentUpdatedAt        DateTime?
  photoNoticeAgreedAt     DateTime?
  bio                     String?
  role                    Role                 @default(MEMBER)
  eventsSignedUp          EventSignup[]
  passwordResetTokens     PasswordResetToken[]
  chatMessages            ChatMessage[]
  chatRooms               ChatRoomMember[]
  pushTokens              PushToken[]
  chatReportsFiled        ChatReport[]         @relation("ChatReportReporter")
  blocking                UserBlock[]          @relation("UserBlockBlocker")
  blockedBy               UserBlock[]          @relation("UserBlockBlocked")
  chatBannedAt            DateTime?
  createdAt               DateTime             @default(now())
  updatedAt               DateTime             @updatedAt
}

model Event {
  id               String        @id @default(cuid())
  slug             String        @unique
  title            String
  subtitle         String?
  description      String?
  location         String?
  startTime        DateTime
  endTime          DateTime?
  groupChatLink    String?
  threadId         String?       @map("thread_id")
  galleryUrl       String?       @map("galleryurl")
  primaryColor     String?
  secondaryColor   String?
  accentColor      String?
  backgroundColor  String?
  textColor        String?
  coverImageUrl    String?
  photosOgTitle    String?
  photosOgSubtitle String?
  photosOgDetail   String?
  signupDeadline   DateTime?
  capacity         Int?
  published        Boolean       @default(true)
  chatEnabled      Boolean       @default(true)
  chatLockedAt     DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  attendees        EventSignup[]
  chatRoom         ChatRoom?
}

model EventSignup {
  id                      String       @id @default(cuid())
  user                    User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId                  String
  event                   Event        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  eventId                 String
  status                  SignupStatus @default(CONFIRMED)
  note                    String?
  specialRequests         String?
  groupChatAdded          Boolean      @default(false)
  actionRequiredMessageId String?
  chatValidationCode      String?      @unique
  createdAt               DateTime     @default(now())

  @@unique([eventId, userId])
}

model GlobalSetting {
  key       String   @id
  value     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

enum ChatMessageKind {
  TEXT
  IMAGE
  ANNOUNCEMENT
  SYSTEM
}

enum ChatReportStatus {
  OPEN
  ACTIONED
  DISMISSED
}

enum ChatRoomKind {
  EVENT
  DIRECT
}

// EVENT rooms: one per event. Who can read/post is derived from a CONFIRMED
// EventSignup (or ADMIN), so RSVPing joins and cancelling leaves automatically.
// DIRECT rooms: one per pair of members (directKey = sorted "userA:userB"),
// membership stored in ChatRoomMember.
model ChatRoom {
  id            String           @id @default(cuid())
  kind          ChatRoomKind
  event         Event?           @relation(fields: [eventId], references: [id], onDelete: Cascade)
  eventId       String?          @unique
  directKey     String?          @unique
  createdAt     DateTime         @default(now())
  lastMessageAt DateTime?
  members       ChatRoomMember[]
  messages      ChatMessage[]

  @@index([lastMessageAt])
}

// Per-member state: read position and mute for every room kind; for DIRECT
// rooms the row is also the membership itself.
model ChatRoomMember {
  room       ChatRoom  @relation(fields: [roomId], references: [id], onDelete: Cascade)
  roomId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     String
  lastReadAt DateTime?
  muted      Boolean   @default(false)
  createdAt  DateTime  @default(now())

  @@id([roomId, userId])
  @@index([userId])
}

model ChatMessage {
  id        String          @id @default(cuid())
  room      ChatRoom        @relation(fields: [roomId], references: [id], onDelete: Cascade)
  roomId    String
  user      User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  userId    String?
  kind      ChatMessageKind @default(TEXT)
  body      String?
  imageUrl  String?
  replyToId String?
  clientId  String?
  createdAt DateTime        @default(now())
  editedAt  DateTime?
  deletedAt DateTime?
  reports   ChatReport[]

  @@unique([roomId, clientId])
  @@index([roomId, createdAt])
}

model PushToken {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  token     String   @unique
  platform  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model ChatReport {
  id         String           @id @default(cuid())
  message    ChatMessage      @relation(fields: [messageId], references: [id], onDelete: Cascade)
  messageId  String
  reporter   User             @relation("ChatReportReporter", fields: [reporterId], references: [id], onDelete: Cascade)
  reporterId String
  reason     String?
  status     ChatReportStatus @default(OPEN)
  createdAt  DateTime         @default(now())
  resolvedAt DateTime?

  @@unique([messageId, reporterId])
  @@index([status])
}

model UserBlock {
  blocker   User     @relation("UserBlockBlocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blockerId String
  blocked   User     @relation("UserBlockBlocked", fields: [blockedId], references: [id], onDelete: Cascade)
  blockedId String
  createdAt DateTime @default(now())

  @@id([blockerId, blockedId])
}
