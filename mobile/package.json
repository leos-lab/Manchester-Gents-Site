{
  "name": "manchester-gents-app",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "setup": "npm install && npx expo install react react-native expo-router expo-constants expo-linking expo-status-bar expo-splash-screen expo-font expo-secure-store expo-notifications expo-device expo-image expo-image-picker expo-glass-effect expo-symbols expo-haptics expo-calendar expo-web-browser expo-clipboard expo-media-library expo-file-system react-native-safe-area-context react-native-screens react-native-gesture-handler react-native-reanimated react-native-worklets && npx expo install --fix",
    "start": "expo start --dev-client",
    "ios": "expo run:ios",
    "android": "expo run:android",
    "test": "node --test test/*.test.mjs",
    "doctor": "npx expo-doctor",
    "postinstall": "patch-package"
  },
  "dependencies": {
    "@expo/ui": "~58.0.26",
    "@react-native-community/datetimepicker": "9.2.1",
    "expo": "~58.0.0",
    "expo-build-properties": "~58.0.12",
    "expo-calendar": "~58.0.6",
    "expo-clipboard": "~58.0.4",
    "expo-constants": "~58.0.14",
    "expo-device": "~58.0.5",
    "expo-file-system": "~58.0.13",
    "expo-font": "~58.0.11",
    "expo-glass-effect": "~58.0.5",
    "expo-haptics": "~58.0.7",
    "expo-image": "~58.0.18",
    "expo-image-picker": "~58.0.10",
    "expo-linking": "~58.0.15",
    "expo-location": "~58.0.20",
    "expo-media-library": "~58.0.13",
    "expo-notifications": "~58.1.7",
    "expo-router": "~58.0.29",
    "expo-secure-store": "~58.0.2",
    "expo-splash-screen": "~58.0.12",
    "expo-status-bar": "~58.0.4",
    "expo-symbols": "~58.0.4",
    "expo-web-browser": "~58.0.7",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.1",
    "react-native-worklets": "0.13.0"
  },
  "engines": {
    "node": ">=22.13"
  },
  "overrides": {
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "patch-package": "^8.0.1"
  }
}
