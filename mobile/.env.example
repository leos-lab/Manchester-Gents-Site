# Website (serves /api/v1). For a phone on your Wi-Fi testing a local site, use your Mac's LAN IP.
EXPO_PUBLIC_API_URL=https://manchestergents.com
# Chat server WebSocket (the API's login response also returns this as chatUrl).
EXPO_PUBLIC_CHAT_URL=wss://chat.manchestergents.com/ws
# Filled in by `eas init`; needed for push notifications.
EAS_PROJECT_ID=
APPLE_TEAM_ID=
