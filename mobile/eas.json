{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "base": {
      "node": "22.13.0",
      "ios": {
        "image": "latest"
      }
    },
    "development": {
      "extends": "base",
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "APP_VARIANT": "development"
      }
    },
    "uat": {
      "extends": "base",
      "environment": "preview",
      "distribution": "store",
      "autoIncrement": true,
      "env": {
        "APP_VARIANT": "uat",
        "EXPO_PUBLIC_API_URL": "https://uat.manchestergents.com",
        "EXPO_PUBLIC_CHAT_URL": "wss://chat-uat.manchestergents.com/ws"
      }
    },
    "preview": {
      "extends": "base",
      "distribution": "internal"
    },
    "production": {
      "extends": "base",
      "autoIncrement": true
    }
  },
  "submit": {
    "uat": {
      "ios": {
        "ascAppId": "6829331248",
        "appleTeamId": "MS98FXR8TX",
        "ascApiKeyPath": "/Users/leoleung/.appstoreconnect/private_keys/AuthKey_D4ZX6QGKA9.p8",
        "ascApiKeyIssuerId": "27a37356-5597-4202-9488-8ed7be82de96",
        "ascApiKeyId": "D4ZX6QGKA9"
      },
      "android": {
        "serviceAccountKeyPath": "/Users/leoleung/.google-play/mcr-gents-uat-play-upload.json",
        "track": "internal",
        "releaseStatus": "draft"
      }
    },
    "production": {}
  }
}
