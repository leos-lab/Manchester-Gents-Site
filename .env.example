DATABASE_URL="postgresql://username:password@host:5432/manchester_gents"
NEXTAUTH_SECRET="replace-with-strong-secret"
NEXTAUTH_URL="http://localhost:3000"

# Pinstripe photo gallery
NEXT_PUBLIC_PINSTRIPE_API_URL="https://api.pinstripehq.com"
NEXT_PUBLIC_PINSTRIPE_SITE_SLUG="manchestergents"
# Server-only token used by admin gallery actions and member photos (avatars,
# private reference photos). Must match Pinstripe API PINSTRIPE_MANAGEMENT_TOKEN or API_TOKEN.
PINSTRIPE_MANAGEMENT_TOKEN="replace-with-random-management-token"

# Email (optional, required for password resets)
EMAIL_FROM="Manchester Gents <no-reply@manchestergents.com>"
# Dev and UAT only: send every email to this inbox instead of the member.
# EMAIL_REDIRECT_TO=uat@manchestergents.com
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_USER="smtp-user"
SMTP_PASS="smtp-password"
# PASSWORD_RESET_TOKEN_TTL_MINUTES=60

# Optional seed helpers
SEED_ADMIN_EMAIL="admin@manchestergents.com"
SEED_ADMIN_PASSWORD="change-me-now"
SEED_ADMIN_HANDLE="manchester.gents"

# Webhooks
MCR_BASE_URL="https://www.mcr.gent"
MAKE_WEBHOOK_TOKEN=
MAKE_WEBHOOK_URL=

# In-app chat + app sign-in (shared with chat-server/.env)
CHAT_TOKEN_SECRET="replace-with-openssl-rand-base64-48"
CHAT_SERVER_URL="wss://chat.manchestergents.com/ws"
# Optional: Expo access token (only if "enhanced push security" is on in your Expo account)
EXPO_ACCESS_TOKEN=""
