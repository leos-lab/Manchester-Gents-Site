# Same database as the site. Use the pooled URL here...
DATABASE_URL="postgresql://user:pass@host/manchester_gents?sslmode=require"
# ...and the direct (non-pooled) URL for LISTEN/NOTIFY, e.g. Neon's non "-pooler" host.
DIRECT_DATABASE_URL="postgresql://user:pass@host/manchester_gents?sslmode=require"
# Must match CHAT_TOKEN_SECRET in the site's environment. openssl rand -base64 48
CHAT_TOKEN_SECRET=""
# Optional: Expo access token if "enhanced push security" is on in your Expo account.
EXPO_ACCESS_TOKEN=""
# Browser origins allowed to connect (native apps are always allowed).
ALLOWED_ORIGINS="https://manchestergents.com,https://www.manchestergents.com,https://www.mcr.gent"
CLOUDFLARE_TUNNEL_TOKEN=""
